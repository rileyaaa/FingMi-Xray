diff --git a/candidate/published_v2_test.go b/published_v2_test.go
new file mode 100644
index 0000000..8ff5b5e
--- /dev/null
+++ b/published_v2_test.go
@@ -0,0 +1,52 @@
+package libXray
+
+import (
+	_ "embed"
+	"encoding/json"
+	"reflect"
+	"testing"
+)
+
+//go:embed testdata/published-v7-api-v2.json
+var publishedV2Oracle []byte
+
+// The oracle contains actual published ARMv7 JNI responses. Exclude network
+// reachability and random key creation; those are exercised separately.
+func TestPublishedV2Dispatcher(t *testing.T) {
+	var oracle struct {
+		Cases []struct {
+			ID       string `json:"id"`
+			Request  any    `json:"request"`
+			Response any    `json:"response"`
+		} `json:"cases"`
+	}
+	if err := json.Unmarshal(publishedV2Oracle, &oracle); err != nil {
+		t.Fatal(err)
+	}
+	selected := map[string]bool{"empty": true, "version0": true, "version1": true, "unknown": true,
+		"test_missing": true, "test_invalid": true, "test_valid": true, "run_valid": true,
+		"running": true, "run_again": true, "stop": true, "stopped": true,
+		"batch_empty": true, "batch_bad": true, "tls_missing": true, "hy2_missing": true,
+		"age_missing": true, "age_key_bad": true}
+	for _, c := range oracle.Cases {
+		if !selected[c.ID] {
+			continue
+		}
+		t.Run(c.ID, func(t *testing.T) {
+			var request string
+			if s, ok := c.Request.(string); ok {
+				request = s
+			} else {
+				b, _ := json.Marshal(c.Request)
+				request = string(b)
+			}
+			var actual any
+			if err := json.Unmarshal([]byte(Invoke(request)), &actual); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(actual, c.Response) {
+				t.Errorf("published=%v, reconstructed=%v", c.Response, actual)
+			}
+		})
+	}
+}
diff --git a/candidate/share/age.go b/share/age.go
new file mode 100644
index 0000000..7f84331
--- /dev/null
+++ b/share/age.go
@@ -0,0 +1,83 @@
+package share
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"strings"
+
+	"github.com/metacubex/age"
+	"github.com/metacubex/age/armor"
+	"github.com/xtls/xray-core/infra/conf"
+)
+
+// Reconstructed behavior from the published Android JNI, not recovered
+// original source. Plain links continue through the regular converter.
+type AgeDecryptConfig struct {
+	SecretKey string `json:"secretKey,omitempty"`
+}
+type AgeKeyPair struct {
+	SecretKey string `json:"secretKey"`
+	PublicKey string `json:"publicKey"`
+}
+
+func GenerateAgeKeyPair(keyType string) (*AgeKeyPair, error) {
+	switch strings.ToLower(strings.TrimSpace(keyType)) {
+	case "", "x25519":
+		key, err := age.GenerateX25519Identity()
+		if err != nil {
+			return nil, err
+		}
+		return &AgeKeyPair{key.String(), key.Recipient().String()}, nil
+	case "hybrid":
+		key, err := age.GenerateHybridIdentity()
+		if err != nil {
+			return nil, err
+		}
+		return &AgeKeyPair{key.String(), key.Recipient().String()}, nil
+	default:
+		return nil, errors.New("unsupported age key type")
+	}
+}
+
+func ConvertShareLinksToXrayJsonWithAge(input string, config *AgeDecryptConfig) (*conf.Config, error) {
+	input = strings.TrimSpace(strings.ReplaceAll(input, "\r\n", "\n"))
+	if !strings.HasPrefix(input, armor.Header) {
+		return ConvertShareLinksToXrayJson(input)
+	}
+	if config == nil || strings.TrimSpace(config.SecretKey) == "" {
+		return nil, errors.New("missing age secret key")
+	}
+	identity, err := parseNativeAgeIdentity(config.SecretKey)
+	if err != nil {
+		return nil, err
+	}
+	decrypted, err := age.Decrypt(armor.NewReader(bufio.NewReader(strings.NewReader(input))), identity)
+	if err != nil {
+		return nil, errors.New("age decryption failed: " + err.Error())
+	}
+	plain, err := io.ReadAll(io.LimitReader(decrypted, 16*1024*1024+1))
+	if err != nil {
+		return nil, errors.New("age decryption failed: " + err.Error())
+	}
+	if len(plain) > 16*1024*1024 {
+		return nil, errors.New("age plaintext too large")
+	}
+	return ConvertShareLinksToXrayJson(string(plain))
+}
+
+func parseNativeAgeIdentity(secret string) (age.Identity, error) {
+	secret = strings.TrimSpace(secret)
+	if strings.HasPrefix(secret, "AGE-SECRET-KEY-PQ-") {
+		identity, err := age.ParseHybridIdentity(secret)
+		if err == nil {
+			return identity, nil
+		}
+	} else if strings.HasPrefix(secret, "AGE-SECRET-KEY-") {
+		identity, err := age.ParseX25519Identity(secret)
+		if err == nil {
+			return identity, nil
+		}
+	}
+	return nil, errors.New("invalid or unsupported age secret key")
+}
diff --git a/candidate/share/age_recovery_test.go b/share/age_recovery_test.go
new file mode 100644
index 0000000..9a2a02c
--- /dev/null
+++ b/share/age_recovery_test.go
@@ -0,0 +1,42 @@
+package share
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/metacubex/age"
+	"github.com/metacubex/age/armor"
+)
+
+func TestPublishedAgeDecryptionRoundTrip(t *testing.T) {
+	pair, err := GenerateAgeKeyPair("x25519")
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity, err := age.ParseX25519Identity(pair.SecretKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ciphertext bytes.Buffer
+	armored := armor.NewWriter(&ciphertext)
+	writer, err := age.Encrypt(armored, identity.Recipient())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = writer.Write([]byte("trojan://password@example.com:443")); err != nil {
+		t.Fatal(err)
+	}
+	if err = writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = armored.Close(); err != nil {
+		t.Fatal(err)
+	}
+	config, err := ConvertShareLinksToXrayJsonWithAge(ciphertext.String(), &AgeDecryptConfig{SecretKey: pair.SecretKey})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(config.OutboundConfigs) != 1 || config.OutboundConfigs[0].Protocol != "trojan" {
+		t.Fatalf("decrypted outbound: %+v", config.OutboundConfigs)
+	}
+}
