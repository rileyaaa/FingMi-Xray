diff --git a/candidate/xray/cert_probe.go b/xray/cert_probe.go
new file mode 100644
index 0000000..bcbb00e
--- /dev/null
+++ b/xray/cert_probe.go
@@ -0,0 +1,66 @@
+package xray
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"time"
+	coreTLS "github.com/xtls/xray-core/transport/internet/tls"
+)
+
+// ProbeTLSCertificate obtains the leaf certificate from a synthetic or real
+// endpoint without requiring it to be trusted. The pin is lowercase SHA-256
+// of the certificate DER, as returned by the published JNI.
+func ProbeTLSCertificate(server string, port int, serverName, fingerprint string, alpn []string, timeout int) (string, error) {
+	server, serverName = strings.TrimSpace(server), strings.TrimSpace(serverName)
+	if server == "" {
+		return "", errors.New("missing TLS server")
+	}
+	if port <= 0 || port > 65535 {
+		return "", errors.New("invalid TLS port")
+	}
+	fingerprint = strings.ToLower(strings.TrimSpace(fingerprint))
+	hello := coreTLS.GetFingerprint(fingerprint)
+	if hello == nil {
+		return "", errors.New("unknown TLS fingerprint")
+	}
+	if serverName == "" {
+		serverName = server
+	}
+	if timeout <= 0 {
+		timeout = 5000
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeout)*time.Millisecond)
+	defer cancel()
+	conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", net.JoinHostPort(server, fmt.Sprint(port)))
+	if err != nil {
+		return "", err
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(time.Duration(timeout) * time.Millisecond))
+	tlsConn := coreTLS.UClient(conn, &tls.Config{ServerName: serverName, NextProtos: cleanProbeALPN(alpn), InsecureSkipVerify: true}, hello).(*coreTLS.UConn)
+	if err := tlsConn.HandshakeContext(ctx); err != nil {
+		return "", err
+	}
+	certificates := tlsConn.ConnectionState().PeerCertificates
+	if len(certificates) == 0 {
+		return "", errors.New("TLS peer has no certificate")
+	}
+	sum := sha256.Sum256(certificates[0].Raw)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+func cleanProbeALPN(alpn []string) []string {
+	clean := make([]string, 0, len(alpn))
+	for _, entry := range alpn {
+		if entry = strings.TrimSpace(entry); entry != "" {
+			clean = append(clean, entry)
+		}
+	}
+	return clean
+}
diff --git a/candidate/xray/cert_probe_test.go b/xray/cert_probe_test.go
new file mode 100644
index 0000000..67b0a03
--- /dev/null
+++ b/xray/cert_probe_test.go
@@ -0,0 +1,29 @@
+package xray
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+)
+
+func TestPublishedTLSProbeLocal(t *testing.T) {
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	defer server.Close()
+	host, rawPort, err := net.SplitHostPort(server.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	port, _ := strconv.Atoi(rawPort)
+	got, err := ProbeTLSCertificate(host, port, "localhost", "", nil, 2000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(server.TLS.Certificates[0].Certificate[0])
+	if got != hex.EncodeToString(sum[:]) {
+		t.Fatalf("pin=%s want=%x", got, sum)
+	}
+}
diff --git a/candidate/xray/hy2_cert_probe.go b/xray/hy2_cert_probe.go
new file mode 100644
index 0000000..78c8e84
--- /dev/null
+++ b/xray/hy2_cert_probe.go
@@ -0,0 +1,47 @@
+package xray
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"time"
+
+	quic "github.com/apernet/quic-go"
+)
+
+// ProbeHysteria2Certificate uses a QUIC handshake to inspect the leaf DER pin.
+func ProbeHysteria2Certificate(server string, port int, serverName string, timeout int) (string, error) {
+	server, serverName = strings.TrimSpace(server), strings.TrimSpace(serverName)
+	if server == "" {
+		return "", errors.New("missing Hysteria2 server")
+	}
+	if port <= 0 || port > 65535 {
+		return "", errors.New("invalid Hysteria2 port")
+	}
+	if serverName == "" {
+		serverName = server
+	}
+	if timeout <= 0 {
+		timeout = 5000
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeout)*time.Millisecond)
+	defer cancel()
+	conn, err := quic.DialAddr(ctx, net.JoinHostPort(server, fmt.Sprint(port)),
+		&tls.Config{ServerName: serverName, NextProtos: []string{"h3"}, InsecureSkipVerify: true},
+		&quic.Config{EnableDatagrams: true})
+	if err != nil {
+		return "", err
+	}
+	defer conn.CloseWithError(0, "")
+	certificates := conn.ConnectionState().TLS.PeerCertificates
+	if len(certificates) == 0 {
+		return "", errors.New("Hysteria2 peer has no certificate")
+	}
+	sum := sha256.Sum256(certificates[0].Raw)
+	return hex.EncodeToString(sum[:]), nil
+}
