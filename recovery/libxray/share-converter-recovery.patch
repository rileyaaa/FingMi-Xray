+func decodeShareUserInfo(user *url.Userinfo) (string, error) {
+	if user == nil {
+		return "", nil
+	}
+	return url.PathUnescape(user.String())
+}
+func parseSharePort(link *url.URL) (uint16, error) {
+	p, e := strconv.ParseUint(link.Port(), 10, 16)
+	if e != nil || p == 0 {
+		return 0, fmt.Errorf("invalid share port %q", link.Port())
+	}
+	return uint16(p), nil
+}
+func firstHysteriaPort(ports string) (string, error) {
+	first := ""
+	for _, part := range strings.Split(ports, ",") {
+		r := strings.Split(part, "-")
+		if len(r) > 2 {
+			return "", fmt.Errorf("invalid hysteria2 port hopping %q", ports)
+		}
+		a, e := strconv.ParseUint(r[0], 10, 16)
+		if e != nil || a == 0 {
+			return "", fmt.Errorf("invalid hysteria2 port hopping %q", ports)
+		}
+		if len(r) == 2 {
+			b, e := strconv.ParseUint(r[1], 10, 16)
+			if e != nil || b < a {
+				return "", fmt.Errorf("invalid hysteria2 port hopping %q", ports)
+			}
+		}
+		if first == "" {
+			first = r[0]
+		}
+	}
+	return first, nil
+}
+func rawQueryHasKey(raw, key string) bool {
+	for _, p := range strings.Split(raw, "&") {
+		k, _, _ := strings.Cut(p, "=")
+		k, e := url.QueryUnescape(k)
+		if e == nil && k == key {
+			return true
+		}
+	}
+	return false
+}
+func normalizeHysteriaMultiPortLink(link string) (string, error) {
+	if !strings.HasPrefix(link, "hy2://") && !strings.HasPrefix(link, "hysteria2://") {
+		return link, nil
+	}
+	start := strings.Index(link, "://") + 3
+	end := len(link)
+	if i := strings.IndexAny(link[start:], "/?#"); i >= 0 {
+		end = start + i
+	}
+	authority := link[start:end]
+	hostStart := strings.LastIndex(authority, "@") + 1
+	host := authority[hostStart:]
+	colon := strings.LastIndex(host, ":")
+	if strings.HasPrefix(host, "[") {
+		close := strings.Index(host, "]")
+		if close < 0 || close+1 >= len(host) || host[close+1] != ':' {
+			return link, nil
+		}
+		colon = close + 1
+	}
+	if colon < 0 {
+		return link, nil
+	}
+	ports := host[colon+1:]
+	if !strings.ContainsAny(ports, ",-") {
+		return link, nil
+	}
+	first, e := firstHysteriaPort(ports)
+	if e != nil {
+		return "", e
+	}
+	suffix := link[end:]
+	body, fragment, hasFragment := strings.Cut(suffix, "#")
+	path, query, hasQuery := strings.Cut(body, "?")
+	if rawQueryHasKey(query, "ports") {
+		return "", fmt.Errorf("ambiguous hysteria2 port hopping")
+	}
+	if hasQuery && query != "" {
+		query += "&"
+	}
+	query += "ports=" + url.QueryEscape(ports)
+	result := link[:start] + authority[:hostStart+colon+1] + first + path + "?" + query
+	if hasFragment {
+		result += "#" + fragment
+	}
+	return result, nil
+}
+func normalizeLegacyShadowsocksLink(link string) (string, error) {
+	if !strings.HasPrefix(link, "ss://") {
+		return link, nil
+	}
+	body, fragment, hasFragment := strings.Cut(link[5:], "#")
+	if strings.Contains(body, "@") {
+		return link, nil
+	}
+	decoded, e := decodeBase64Text(body)
+	if e != nil {
+		return "", e
+	}
+	at := strings.LastIndex(decoded, "@")
+	if at <= 0 || at == len(decoded)-1 {
+		return "", fmt.Errorf("invalid legacy shadowsocks link")
+	}
+	cipher, password, ok := strings.Cut(decoded[:at], ":")
+	if !ok || cipher == "" {
+		return "", fmt.Errorf("invalid legacy shadowsocks credentials")
+	}
+	result := "ss://" + url.UserPassword(cipher, password).String() + "@" + decoded[at+1:]
+	if hasFragment {
+		result += "#" + fragment
+	}
+	return result, nil
+}
+func normalizeHysteriaPinSHA256(pin string) (string, error) {
+	pin = strings.ToLower(strings.ReplaceAll(strings.ReplaceAll(strings.TrimSpace(pin), ":", ""), "-", ""))
+	if len(pin) != 64 {
+		return "", fmt.Errorf("invalid hysteria2 certificate pin")
+	}
+	for _, r := range pin {
+		if !(r >= '0' && r <= '9' || r >= 'a' && r <= 'f') {
+			return "", fmt.Errorf("invalid hysteria2 certificate pin")
+		}
+	}
+	return pin, nil
+}
+func cleanShareALPN(values []string) []string {
+	out := make([]string, 0, len(values))
+	for _, v := range values {
+		if v = strings.TrimSpace(v); v != "" {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+func parseShareALPN(value string) []string {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil
+	}
+	if strings.HasPrefix(value, "[") {
+		var a []string
+		if json.Unmarshal([]byte(value), &a) == nil {
+			return cleanShareALPN(a)
+		}
+	}
+	return cleanShareALPN(strings.Split(value, ","))
+}
+func legacyKCPMTU(header string, seedPresent bool) (uint32, error) {
+	overhead := uint32(0)
+	switch strings.ToLower(strings.TrimSpace(header)) {
+	case "", "none":
+	case "dns":
+		overhead = 31
+	case "dtls", "wechat", "wechat-video":
+		overhead = 13
+	case "srtp", "utp", "wireguard":
+		overhead = 4
+	default:
+		return 0, fmt.Errorf("unsupported legacy mKCP header: %s", header)
+	}
+	if seedPresent {
+		return 1350 - overhead - 16, nil
+	}
+	return 1350 - overhead - 6, nil
+}
+func legacyKCPFinalMask(header, seed string, seedPresent bool) (*conf.FinalMask, error) {
+	header = strings.ToLower(strings.TrimSpace(header))
+	switch header {
+	case "", "none":
+		header = ""
+	case "wechat-video":
+		header = "wechat"
+	case "dns", "dtls", "wechat", "srtp", "utp", "wireguard":
+	default:
+		return nil, fmt.Errorf("unsupported legacy mKCP header: %s", header)
+	}
+	if !seedPresent {
+		seed = ""
+	}
+	mask := func(h, v string) conf.Mask {
+		raw, _ := json.Marshal(struct {
+			Header string `json:"header"`
+			Value  string `json:"value"`
+		}{h, v})
+		r := json.RawMessage(raw)
+		return conf.Mask{Type: "mkcp-legacy", Settings: &r}
+	}
+	udp := []conf.Mask{mask("", seed)}
+	if header != "" {
+		udp = append(udp, mask(header, ""))
+	}
+	return &conf.FinalMask{Udp: udp}, nil
+}
