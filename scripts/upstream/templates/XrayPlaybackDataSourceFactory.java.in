package com.fingmi.integration.xray;

import androidx.media3.datasource.DataSource;
import androidx.media3.datasource.DefaultDataSource;
import androidx.media3.datasource.HttpDataSource;
import androidx.media3.datasource.okhttp.OkHttpDataSource;

import com.fingmi.xray.network.XrayHttpClient;
import com.fongmi.android.tv.App;
import com.github.catvod.utils.Auth;
import com.google.common.net.HttpHeaders;

import java.util.Map;
import java.util.Objects;

import okhttp3.Call;
import okhttp3.Request;

/**
 * 5.8.7+ app-only bridge: Xray playback requests use the session SOCKS client.
 * Normal FongMi playback continues to use its own upstream factory.
 *
 * Auth.Context follows FongMi's same-origin URL/header rules, but the final
 * request is dispatched only through the Xray client's Call.Factory.
 */
public final class XrayPlaybackDataSourceFactory {
    private XrayPlaybackDataSourceFactory() {}

    public static DataSource.Factory create(
            Map<String, String> headers, Auth.Context auth, XrayHttpClient proxy) {
        Objects.requireNonNull(proxy, "Xray playback proxy");
        Call.Factory calls = auth == null ? proxy.client()
                : request -> proxy.client().newCall(applyAuth(request, auth));
        HttpDataSource.Factory http = new OkHttpDataSource.Factory(calls);
        http.setDefaultRequestProperties(headers == null ? Map.of() : headers);
        DataSource.Factory delegate = new DefaultDataSource.Factory(App.get(), http);
        return () -> new XrayGuardedPlaybackDataSource(delegate.createDataSource());
    }

    private static Request applyAuth(Request request, Auth.Context auth) {
        String authorization = request.header(HttpHeaders.AUTHORIZATION);
        Map<String, String> existing = authorization == null
                ? Map.of() : Map.of(HttpHeaders.AUTHORIZATION, authorization);
        String url = auth.getUrl(request.url().toString(), existing);
        Request.Builder builder = request.newBuilder().url(url).tag(Auth.Context.class, auth);
        auth.getHeaders(url, existing).forEach(builder::header);
        return builder.build();
    }
}
