package com.fingmi.integration.xray;

import android.app.Activity;
import android.app.AlertDialog;
import android.graphics.Bitmap;
import android.view.Gravity;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.TextView;

import com.fongmi.android.tv.R;
import com.fongmi.android.tv.server.Server;
import com.fongmi.android.tv.utils.QRCode;

/** Xray-only mobile pairing page; no dependency on removed FongMi PushActivity. */
public final class XrayPhoneImportDialog {

    private XrayPhoneImportDialog() {}

    public static void show(Activity activity) {
        // Nano serves every regular app asset path, including this standalone
        // Xray-only page, while regular FongMi web UI remains untouched.
        String url = Server.get().getAddress() + "/xray.html";
        Bitmap bitmap = QRCode.getBitmap(url, 240, 1);
        if (bitmap == null) throw new IllegalStateException("Xray pairing QR could not be generated");

        int padding = Math.round(activity.getResources().getDisplayMetrics().density * 20);
        LinearLayout content = new LinearLayout(activity);
        content.setOrientation(LinearLayout.VERTICAL);
        content.setGravity(Gravity.CENTER_HORIZONTAL);
        content.setPadding(padding, padding, padding, padding);

        ImageView code = new ImageView(activity);
        code.setContentDescription(url);
        code.setImageBitmap(bitmap);
        content.addView(code);

        TextView message = new TextView(activity);
        message.setGravity(Gravity.CENTER);
        message.setText(activity.getString(R.string.xray_phone_scan_info, Server.get().getAddress()));
        content.addView(message);

        TextView address = new TextView(activity);
        address.setGravity(Gravity.CENTER);
        address.setText(url);
        address.setTextIsSelectable(true);
        content.addView(address);

        new AlertDialog.Builder(activity)
                .setTitle(R.string.xray_setting)
                .setView(content)
                .setPositiveButton(android.R.string.ok, null)
                .show();
    }
}
